    {
        "id": "56d9722e1f130456",
        "type": "function",
        "z": "4c843baa23199913",
        "name": "function 1",
        "func": "let data = msg.payload;\nlet commands = [];\n\n// Kiểm tra trạng thái máy bơm M1\nif (data.pump_status !== undefined) {\n    commands.push(\"PUMP:\" + (data.pump_status ? \"1\" : \"0\"));\n}\n\n// Kiểm tra trạng thái đèn sưởi L1\nif (data.lamp_status !== undefined) {\n    commands.push(\"LED:\" + (data.lamp_status ? \"1\" : \"0\"));\n}\n\n// Nếu có thay đổi chế độ Auto/Manual\nif (data.system_mode !== undefined) {\n    commands.push(\"MODE:\" + data.system_mode.toUpperCase());\n}\n\n// Trả về từng lệnh để gửi xuống MQTT\nif (commands.length > 0) {\n    // Nối các lệnh bằng dấu phẩy hoặc gửi lệnh đầu tiên (tùy cách Arduino của bạn tách chuỗi)\n    msg.payload = commands.join(\",\"); \n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
